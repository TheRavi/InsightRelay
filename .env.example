# Research Agent Swarm environment configuration

# Search mode: simulated (offline) or live (uses Tavily)
SEARCH_MODE=simulated
TAVILY_API_KEY=

# Ollama settings
OLLAMA_URL=http://localhost:11434/api/chat
MODEL=llama3.2

# LLM provider: ollama or cerebras
LLM_PROVIDER=ollama

# Cerebras settings
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# Runtime limits
REQUEST_TIMEOUT_SECONDS=120
MAX_AGENT_STEPS=8
MAX_OUTPUT_CHARS=20000